# PlantPilot environment configuration
# Copy to .env and adjust values for your deployment.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=PlantPilot
APP_ENV=development
APP_DEBUG=true
# Public URL of the API/app (used for QR links, invites later)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated origins allowed for CORS (Vite dev server included)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# open | invite | closed
REGISTRATION_MODE=open
# Generate a long random string for production (openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Used by the API container / local uvicorn
DATABASE_URL=postgresql+asyncpg://plantpilot:plantpilot@localhost:5432/plantpilot
# Used by docker-compose for the Postgres service
POSTGRES_USER=plantpilot
POSTGRES_PASSWORD=plantpilot
POSTGRES_DB=plantpilot
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Auth tokens
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Media storage
# -----------------------------------------------------------------------------
# Local dev default; Compose overrides to /data/media
MEDIA_ROOT=./data/media
MAX_UPLOAD_MB=15

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# Free plant photo ID: https://my.plantnet.org/ (optional; also settable in UI Settings)
# PLANTNET_API_KEY=
# Weather uses Open-Meteo — no key required
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Host/port when running API outside Compose
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
