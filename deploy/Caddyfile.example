# Example reverse proxy for RootCore
# Point your domain at the host and proxy to the Compose API port.

{$DOMAIN:localhost} {
	encode gzip zstd
	reverse_proxy api:8000

	header {
		# Basic hardening; adjust for your environment
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
